#version=RHEL9
text
reboot
firstboot --disable
lang en_US.UTF-8
keyboard us
timezone Etc/UTC --utc
rootpw --lock
user --name=rocky --groups=wheel --lock
sshkey --username=rocky "${ssh_public_key}"
selinux --enforcing
firewall --enabled --service=ssh
services --enabled=sshd,qemu-guest-agent,chronyd,firewalld,NetworkManager
network --bootproto=dhcp --device=link --activate --onboot=yes --hostname=rocky-template

# The ISO supplies the installer; online repositories supply all packages,
# including cloud-init and the QEMU guest agent that minimal media may omit.
url --url=https://dl.rockylinux.org/pub/rocky/9/BaseOS/x86_64/os/
repo --name=AppStream --baseurl=https://dl.rockylinux.org/pub/rocky/9/AppStream/x86_64/os/

ignoredisk --only-use=sda
zerombr
clearpart --all --initlabel --disklabel=gpt --drives=sda
bootloader --boot-drive=sda
# Plain partitions let cloud-init grow the root partition on larger clones.
part /boot/efi --fstype=efi --size=600 --ondisk=sda --fsoptions="umask=0077,shortname=winnt"
part /boot --fstype=xfs --size=1024 --ondisk=sda
part swap --fstype=swap --size=4096 --ondisk=sda
part / --fstype=xfs --size=8192 --grow --ondisk=sda

%packages --excludedocs
@^minimal-environment
cloud-init
cloud-utils-growpart
qemu-guest-agent
openssh-server
chrony
firewalld
NetworkManager
bind-utils
iproute
iputils
curl
sudo
policycoreutils
%end

%post --erroronfail --log=/root/ks-post.log
# Cloud-init is for cloned VMs. Avoid races with Packer on the install boot.
touch /etc/cloud/cloud-init.disabled
cat > /etc/sudoers.d/rocky <<'SUDO'
rocky ALL=(ALL) NOPASSWD:ALL
SUDO
chmod 0440 /etc/sudoers.d/rocky
restorecon -RF /home/rocky/.ssh /etc/sudoers.d
%end
